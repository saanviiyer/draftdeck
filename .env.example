# ---------------------------------------------------------------------------
# DraftDeck configuration. Copy this file to `.env` and fill in as needed.
# The app runs fully in MOCK + DRY-RUN mode with NO keys set.
# ---------------------------------------------------------------------------

# Anthropic API key. If unset, the server runs in MOCK MODE and returns
# realistic draft variants locally (no network call). Leave blank to try the
# app with zero setup.
ANTHROPIC_API_KEY=

# Model used for drafting when a real key is provided.
ANTHROPIC_MODEL=claude-sonnet-5
UPSTREAM_TIMEOUT_MS=30000

# Port the backend listens on.
PORT=8787

# Required in production (minimum 12 characters). Protects all draft data and actions.
OWNER_KEY=

# Durable snapshot directory and reverse-proxy setting.
DATA_DIR=
TRUST_PROXY=

# ---------------------------------------------------------------------------
# PUBLISHING SAFETY GATE
# ---------------------------------------------------------------------------
# Publishing is DISABLED by default. While false, the "Approve & Publish"
# action only SIMULATES publishing (dry-run) and logs what would happen.
# NO external platform is ever contacted in dry-run mode.
#
# Set this to `true` ONLY if you intend to publish for real, understand that
# real posts will be sent on your behalf, and have provided your own platform
# credentials below. You are responsible for everything published this way.
PUBLISH_ENABLED=false

# ---------------------------------------------------------------------------
# Real platform credentials (placeholders — only used when PUBLISH_ENABLED=true
# AND the corresponding stub adapter is implemented). Never commit real values.
# ---------------------------------------------------------------------------
# Twitter / X
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# LinkedIn
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# Instagram (Graph API)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Blog (generic webhook / CMS endpoint)
BLOG_API_ENDPOINT=
BLOG_API_TOKEN=
